// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
	provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id                   String        @id @default(cuid())
  memberNumber         String        @unique
  accountNumber        String        @unique
  name                 String
  email                String?       @unique
  password             String        @default("temp") // Hashed password
  phone                String        @unique
  nationalId           String        @unique
  dateJoined           DateTime
  role                 Role          @default(MEMBER)
  savings              Saving[]
  loans                Loan[]
  guarantees           LoanGuarantor[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  groups               Group[]       @relation("GroupMembers")
  createdGroups        Group[]
  officerLoans         Loan[]        @relation("OfficerLoans")
  verifiedLoans        Loan[]        @relation("VerifiedLoans")
  approvedLoans        Loan[]        @relation("ApprovedLoans")
}

model Saving {
  id                   String   @id @default(cuid())
  member               Member   @relation(fields: [memberId], references: [id])
  memberId             String
  amount               Decimal  @db.Decimal(12, 2)
  month                DateTime
  recordedAt           DateTime @default(now())
  transactionReference String?  // For MPESA details
  note                 String?
}

model Loan {
  id                   String        @id @default(cuid())
  member               Member        @relation(fields: [memberId], references: [id])
  memberId             String
  principal            Decimal       @db.Decimal(12, 2)
  interestRate         Decimal       @db.Decimal(5, 2)
  interestAmount       Decimal       @db.Decimal(12, 2)
  monthlyInstallment   Decimal       @db.Decimal(12, 2)
  termMonths           Int
  purpose              String
  issuedAt             DateTime      @default(now())
  dueDate              DateTime
  status               LoanStatus    @default(PENDING)
  repayments           Repayment[]
  type                 LoanType      @default(SHORT_TERM)
  guarantors           LoanGuarantor[]
  documents            LoanDocument[]
  officerId            String?
  verifiedById         String?
  approvedById         String?
  officer              Member?       @relation("OfficerLoans", fields: [officerId], references: [id])
  verifiedBy           Member?       @relation("VerifiedLoans", fields: [verifiedById], references: [id])
  approvedBy           Member?       @relation("ApprovedLoans", fields: [approvedById], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Repayment {
  id        String   @id @default(cuid())
  loan      Loan     @relation(fields: [loanId], references: [id])
  loanId    String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?
}

model LoanGuarantor {
  id        String @id @default(cuid())
  loan      Loan   @relation(fields: [loanId], references: [id])
  loanId    String
  member    Member @relation(fields: [memberId], references: [id])
  memberId  String
}

model LoanDocument {
  id        String   @id @default(cuid())
  loan      Loan     @relation(fields: [loanId], references: [id])
  loanId    String
  name      String
  url       String
  type      String
  createdAt DateTime @default(now())
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  members     Member[] @relation("GroupMembers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Member   @relation(fields: [createdById], references: [id])
  createdById String
}

enum Role {
  ADMIN
  TREASURER
  MEMBER
  OFFICER
  VERIFIER
  APPROVER
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum LoanType {
  SHORT_TERM
  SIX_MONTH
}
